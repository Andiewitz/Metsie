{
  "name": "metsie-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js frontend + modular Django services with 7-day httpOnly JWT cookies",
  "scripts": {
    "dev": "./dev.sh",
    "test": "bash scripts/run_unit_tests.sh",
    "test:unit": "bash scripts/run_unit_tests.sh",
    "test:e2e": "bash scripts/run_e2e_tests.sh",
    "lint": "bash scripts/run_lint.sh",
    "lint:backend": "services/.venv/bin/ruff check services/",
    "lint:frontend": "cd client && npm run lint"
  }
}
