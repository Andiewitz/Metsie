# ─── Backend Environment Configuration Template ───────────────────────────────
# Copy this to services/.env for local development.
# On Railway, set these directly as environment variables in the Railway dashboard.

# ── Core Django ───────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret key for production
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production

# Set DEBUG=False in production, True for local dev
DEBUG=False

# "production" or "development"
ENVIRONMENT=production

# Comma-separated list of allowed hostnames
# On Railway, your domain is injected automatically via RAILWAY_PUBLIC_DOMAIN
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────────────────────────
# Railway Postgres Plugin: DATABASE_URL is auto-injected — no configuration needed.
# If self-hosting Postgres without DATABASE_URL, use the individual vars below:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

DB_ENGINE=django.db.backends.postgresql
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=change-this-db-password
DB_HOST=localhost
DB_PORT=5432

# ── JWT & Cookie ───────────────────────────────────────────────────────────────
# REQUIRED: Use a different secret from DJANGO_SECRET_KEY
JWT_SECRET_KEY=change-this-to-a-strong-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Set to True in production (HTTPS only). Railway uses HTTPS automatically.
COOKIE_SECURE=True

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: https://metsie.up.railway.app,https://metsie.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── CSRF ───────────────────────────────────────────────────────────────────────
# Comma-separated list of trusted origins for CSRF
# Must include your frontend Railway URL in production
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ── Railway-Injected (Do Not Set Manually) ────────────────────────────────────
# These are automatically provided by Railway at runtime:
# RAILWAY_PUBLIC_DOMAIN — public hostname of this service (e.g. metsie-backend.up.railway.app)
# PORT — the port Railway wants the process to bind on
